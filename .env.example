# ===== 飞书应用凭证（在 https://open.feishu.cn/app 创建「企业自建应用」后获得）=====
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ===== 飞书多维表格 Base token（打开表格后，URL 中 bases/ 后面的那段）=====
BASE_TOKEN=Wwtfbm66VaJyLOsBQaTcTm1vnHg

# ===== 网页访问密码（必填！否则任何拿到链接的人都能直连写入你的飞书）=====
ACCESS_PWD=请把这里改成你自己的强密码

# ===== 服务端口（PaaS 一般会自动注入 PORT；本地运行默认 3210）=====
PORT=3210
